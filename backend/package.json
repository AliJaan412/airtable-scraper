{
  "name": "airtable-scraper-backend",
  "version": "1.0.0",
  "description": "Airtable Integration Backend",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:tsnd": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
