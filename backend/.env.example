PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sred_io

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# Airtable OAuth
AIRTABLE_CLIENT_ID=your-airtable-client-id
AIRTABLE_CLIENT_SECRET=your-airtable-client-secret
AIRTABLE_REDIRECT_URI=http://localhost:3000/api/airtable/oauth/callback
AIRTABLE_SCOPE=data.records:read data.records:write schema.bases:read schema.bases:write user.email:read

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4200

# Default Organization ID (for single-tenant dev)
DEFAULT_ORG_ID=default-org

# Redis (for job queues and caching)
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=300
